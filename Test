@(
"PresentationFramework",
"PresentationCore",
"WindowsBase",
"System.Xaml"
) | ForEach-Object {
    try {
        $a = [Reflection.Assembly]::LoadWithPartialName($_)
        if ($a) {
            Write-Host "OK : $_" -ForegroundColor Green
        } else {
            Write-Host "ABSENT : $_" -ForegroundColor Red
        }
    }
    catch {
        Write-Host "ERREUR : $_" -ForegroundColor Red
    }
}
